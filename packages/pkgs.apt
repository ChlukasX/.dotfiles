# Not in default repos — install manually / via vendor repo:
#   tree-sitter-cli  (npm i -g tree-sitter-cli)
#   uv               (curl -LsSf https://astral.sh/uv/install.sh | sh)
#   typst            (cargo / GitHub release)
#   lazygit, lazydocker (GitHub releases)
#   claude-code      (npm i -g @anthropic-ai/claude-code)
#   wezterm          (apt.fury.io/wez repo)
#   meslo nerd font  (nerdfonts.com)
#   brave, discord, obsidian, zotero, zed, proton-vpn (vendor .deb / repos)
